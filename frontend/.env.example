# Copy this file to .env for local development. Never commit the real .env.
# Only needed if the API isn't reachable at the default local port — the
# Docker Compose stack and `npm run dev` both work with no .env at all.

# The browser-reachable origin of the API. Defaults to http://localhost:8000
# (see frontend/src/api/config.ts) if unset.
VITE_API_BASE_URL=http://localhost:8000
