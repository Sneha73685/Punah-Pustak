# Copy this file to .env for local development. Never commit the real .env.

ENVIRONMENT=local

# --- Database (§11) ---
DATABASE_URL=postgresql+psycopg://punah:punah@db:5432/punah_pustak

# --- Auth / tokens (§15.3) ---
JWT_SECRET=local-dev-secret-change-me-before-deploying
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Rate limiting (SEC-040) ---
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Trusted proxy (SEC-040) ---
# Number of reverse-proxy hops in front of this service that are trusted to
# have appended their own observed peer to X-Forwarded-For. 0 (the default,
# correct for local dev -- nothing sits in front of uvicorn here) means "use
# the raw TCP peer, ignore X-Forwarded-For entirely". Render's production
# deployment sets this to 2 (Render's own edge/load-balancer + Cloudflare in
# front of it) -- see Settings.trusted_proxy_hop_count and
# app.modules.auth.dependencies._extract_client_ip for the full trust model.
TRUSTED_PROXY_HOP_COUNT=0

# --- CORS (DEPLOY-024) ---
# Exact origin(s) only, comma-separated, no wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Object storage (BE-030) ---
# STORAGE_ENDPOINT_URL: server-to-server (API container -> storage), never
# browser-reachable. STORAGE_PUBLIC_URL: base URL returned in image URLs —
# what a BROWSER fetches images from. These differ under docker-compose
# (internal hostname vs. host-published port) and MUST both be set.
STORAGE_ENDPOINT_URL=http://storage:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_BUCKET=punah-pustak-listing-images
STORAGE_ACCESS_KEY=punah-pustak-local
STORAGE_SECRET_KEY=punah-pustak-local-secret

# --- Cookies (SEC-022, DEPLOY-025) ---
# MUST be true in every deployed environment. Only relax to false for local
# plain-HTTP development.
COOKIE_SECURE=false

# --- Logging (NFR-006) ---
LOG_LEVEL=INFO
