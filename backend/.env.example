# Copy this file to .env for local development. Never commit the real .env.

ENVIRONMENT=local

# --- Database (§11) ---
DATABASE_URL=postgresql+psycopg://punah:punah@db:5432/punah_pustak

# --- Auth / tokens (§15.3) ---
JWT_SECRET=local-dev-secret-change-me-before-deploying
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Rate limiting (SEC-040) ---
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- CORS (DEPLOY-024) ---
# Exact origin(s) only, comma-separated, no wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Object storage (BE-030) — not used until Milestone 2, present per BE-020 ---
STORAGE_ENDPOINT_URL=http://storage:9000
STORAGE_BUCKET=punah-pustak-listing-images
STORAGE_ACCESS_KEY=punah-pustak-local
STORAGE_SECRET_KEY=punah-pustak-local-secret

# --- Cookies (SEC-022, DEPLOY-025) ---
# MUST be true in every deployed environment. Only relax to false for local
# plain-HTTP development.
COOKIE_SECURE=false

# --- Logging (NFR-006) ---
LOG_LEVEL=INFO
